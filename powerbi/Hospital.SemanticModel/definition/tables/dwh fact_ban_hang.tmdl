	column tuoi_kh =
			VAR ns = LOOKUPVALUE('dwh dim_benh_nhan'[nam_sinh], 'dwh dim_benh_nhan'[ho_ten], 'dwh fact_ban_hang'[ten_kh], BLANK())
			RETURN IF(ISBLANK(ns) || ns < 1900, BLANK(), YEAR('dwh fact_ban_hang'[ngay]) - ns)
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 2694503a-5c4d-4c48-82e1-8bec2cc6aa31
		summarizeBy: none

	column nhom_tuoi_kh_sort =
			VAR t = 'dwh fact_ban_hang'[tuoi_kh]
			RETURN SWITCH(TRUE(), ISBLANK(t), 7, t <= 5, 1, t <= 15, 2, t <= 25, 3, t <= 40, 4, t <= 60, 5, 6)
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 74f1dce7-0f50-44c5-a4bc-a579a3bcf9ce
		summarizeBy: none

	column nhom_tuoi_kh = SWITCH('dwh fact_ban_hang'[nhom_tuoi_kh_sort], 1, "0-5", 2, "6-15", 3, "16-25", 4, "26-40", 5, "41-60", 6, "60+", "Chưa xác định")
		dataType: string
		lineageTag: adb0db14-aa1f-4262-8d2b-9ce2fe545444
		summarizeBy: none
		sortByColumn: nhom_tuoi_kh_sort

	column doi_tuong_kham =
			VAR ten = 'dwh fact_ban_hang'[ten_kh]
			VAR dk = 'dwh fact_ban_hang'[date_key]
			VAR nv = CALCULATE(COUNTROWS('dwh fact_kham'), REMOVEFILTERS('dwh fact_ban_hang'), 'dwh fact_kham'[date_key] = dk, 'dwh dim_benh_nhan'[ho_ten] = ten)
			VAR bh = CALCULATE(COUNTROWS('dwh fact_kham'), REMOVEFILTERS('dwh fact_ban_hang'), 'dwh fact_kham'[date_key] = dk, 'dwh dim_benh_nhan'[ho_ten] = ten, 'dwh fact_kham'[doi_tuong] = "BHYT" || 'dwh fact_kham'[muc_huong_bhyt] > 0)
			RETURN IF(NOT (nv > 0), "Không khám (mua lẻ)", IF(bh > 0, "BHYT", "Viện phí"))
		dataType: string
		lineageTag: f73cfa74-5235-425d-ba56-d77786652942
		summarizeBy: none

	column loai_khach = IF('dwh fact_ban_hang'[doi_tuong_kham] = "Không khám (mua lẻ)", "Khách lẻ", "Có khám")
		dataType: string
		lineageTag: 2b4d6eac-d998-4a65-a417-47c31bc748ac
		summarizeBy: none

	partition 'dwh fact_ban_hang' = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database("localhost", "Hitech Hospital"),
				    dwh_fact_ban_hang = Source{[Schema="dwh",Item="fact_ban_hang"]}[Data]
				in
				    dwh_fact_ban_hang

	annotation PBI_ResultType = Table

