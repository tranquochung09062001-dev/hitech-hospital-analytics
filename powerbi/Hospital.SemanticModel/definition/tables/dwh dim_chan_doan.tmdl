	partition 'dwh dim_chan_doan' = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database("localhost", "Hitech Hospital"),
				    dwh_dim_chan_doan = Source{[Schema="dwh",Item="dim_chan_doan"]}[Data],
				    // Mã chẩn đoán in hoa: h10 -> H10 (Power BI không phân biệt hoa/thường)
				    InHoa = Table.TransformColumns(dwh_dim_chan_doan, {{"ma_cd", each Text.Upper(Text.Trim(_)), type text}, {"nhom_icd", each if _ = null then null else Text.Upper(_), type text}}),
				    // Bỏ mã trùng sau khi in hoa, giữ 1 dòng
				    KhongTrung = Table.Distinct(InHoa, {"ma_cd"})
				in
				    KhongTrung

	annotation PBI_ResultType = Table

