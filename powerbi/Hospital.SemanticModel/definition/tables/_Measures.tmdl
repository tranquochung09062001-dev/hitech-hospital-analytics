	measure 'IN1 Cơ cấu' =
			VAR t = [Tổng DT]
			VAR k = DIVIDE([DT Khám], t) VAR g = DIVIDE([DT Kính], t) VAR th = DIVIDE([DT Thuốc], t)
			RETURN "Tổng doanh thu " & FORMAT((t) / 1000000000, "#,0.00") & " tỷ" & ". Khám " & FORMAT(k, "0%") & " · Kính " & FORMAT(g, "0%") & " · Thuốc " & FORMAT(th, "0%") & ". " & IF(k >= 0.5, "Khám là trụ cột; quầy kính/thuốc còn dư địa bán chéo.", "Doanh thu khá cân bằng giữa các mảng.")
		displayFolder: 8. Insights
		lineageTag: 9c6ee0c8-5be6-44aa-801c-f5a27e2430ed

	measure 'IN2 Theo tháng' =
			VAR t = FILTER(ADDCOLUMNS(VALUES('dwh dim_ngay'[thang_nam]), "@dt", [Tổng DT]), [@dt] > 0)
			VAR a = AVERAGEX(t, [@dt])
			VAR b = TOPN(1, t, [@dt], DESC) VAR w = TOPN(1, FILTER(t, [@dt] >= a * 0.3), [@dt], ASC)
			RETURN "Cao nhất " & MAXX(b, 'dwh dim_ngay'[thang_nam]) & ": " & FORMAT((MAXX(b, [@dt])) / 1000000000, "#,0.00") & " tỷ" & ". Thấp nhất " & MAXX(w, 'dwh dim_ngay'[thang_nam]) & ": " & FORMAT((MAXX(w, [@dt])) / 1000000000, "#,0.00") & " tỷ" & ". Bình quân " & FORMAT((a) / 1000000000, "#,0.00") & " tỷ" & "/tháng."
		displayFolder: 8. Insights
		lineageTag: 29b7dbb5-e7b2-4f21-b3b4-a9d39046e3a2

	measure 'IN3 Dịch vụ' =
			VAR t = FILTER(ADDCOLUMNS(VALUES('dwh dim_dich_vu'[ten_dich_vu]), "@dt", [DT Khám]), [@dt] > 0)
			VAR b = TOPN(1, t, [@dt], DESC) VAR t3 = SUMX(TOPN(3, t, [@dt], DESC), [@dt])
			RETURN MAXX(b, 'dwh dim_dich_vu'[ten_dich_vu]) & " dẫn đầu với " & FORMAT((MAXX(b, [@dt])) / 1000000000, "#,0.00") & " tỷ" & " (" & FORMAT(DIVIDE(MAXX(b, [@dt]), [DT Khám]), "0%") & " DT khám). Top 3 dịch vụ chiếm " & FORMAT(DIVIDE(t3, [DT Khám]), "0%") & " — doanh thu phụ thuộc lớn vào vài gói."
		displayFolder: 8. Insights
		lineageTag: 19378b19-91cf-455b-b05d-f4063bccdd55

	measure 'IN4 Nội trú' =
			VAR pl = DIVIDE([Lượt nội trú], [Số lượt khám]) VAR pd = DIVIDE([DT nội trú], [DT Khám])
			VAR a1 = DIVIDE([DT nội trú], [Lượt nội trú]) VAR a2 = DIVIDE([DT ngoại trú], [Số lượt khám] - [Lượt nội trú])
			RETURN "Phẫu thuật (nội trú) chỉ " & FORMAT(pl, "0%") & " lượt nhưng mang về " & FORMAT(pd, "0%") & " DT khám. TB " & FORMAT(a1 / 1000000, "#,0.0") & " tr/lượt nội trú so với " & FORMAT(a2 / 1000000, "#,0.0") & " tr/lượt ngoại trú."
		displayFolder: 8. Insights
		lineageTag: 90e0e274-0c8b-4599-8cbc-83c6562daabf

	measure 'IN5 BHYT' =
			VAR p = [% BN BHYT] VAR d = DIVIDE([Tiền BHYT], [DT Khám])
			RETURN "BN BHYT chiếm " & FORMAT(p, "0%") & " số bệnh nhân. Tiền BHYT phải thu " & FORMAT(([Tiền BHYT]) / 1000000000, "#,0.00") & " tỷ" & " (" & FORMAT(d, "0%") & " DT khám) — khoản chờ BHXH hoàn, cần theo dõi dòng tiền."
		displayFolder: 8. Insights
		lineageTag: 579feec1-97fd-4197-8609-b61d92494d1e

	measure 'IN6 Độ tuổi' =
			VAR t = FILTER(ADDCOLUMNS(VALUES('dwh fact_kham'[nhom_tuoi]), "@dt", [DT Khám]), [@dt] > 0)
			VAR b = TOPN(1, t, [@dt], DESC)
			VAR o40 = CALCULATE([DT Khám], KEEPFILTERS('dwh fact_kham'[nhom_tuoi] IN {"41-60", "60+"}))
			RETURN "Nhóm " & MAXX(b, 'dwh fact_kham'[nhom_tuoi]) & " tuổi đóng góp nhiều nhất (" & FORMAT(DIVIDE(MAXX(b, [@dt]), [DT Khám]), "0%") & "). BN trên 40 tuổi chiếm " & FORMAT(DIVIDE(o40, [DT Khám]), "0%") & " DT khám — tập trung chương trình cho người trung, cao tuổi."
		displayFolder: 8. Insights
		lineageTag: a28aa9b1-e738-4853-8547-350dd1e75a00

	measure 'IN7 Địa lý' =
			VAR t = FILTER(ADDCOLUMNS(VALUES('dwh dim_dia_ly'[tinh_tp]), "@dt", [DT Khám]), [@dt] > 0)
			VAR b = TOPN(1, t, [@dt], DESC) VAR n1 = MAXX(b, 'dwh dim_dia_ly'[tinh_tp])
			VAR b2 = TOPN(1, FILTER(t, 'dwh dim_dia_ly'[tinh_tp] <> n1), [@dt], DESC)
			RETURN n1 & " chiếm " & FORMAT(DIVIDE(MAXX(b, [@dt]), [DT Khám]), "0%") & " DT khám. Tỉnh thứ 2 là " & MAXX(b2, 'dwh dim_dia_ly'[tinh_tp]) & " (" & FORMAT(DIVIDE(MAXX(b2, [@dt]), [DT Khám]), "0%") & ") — còn dư địa thu hút BN tỉnh lân cận."
		displayFolder: 8. Insights
		lineageTag: 701f072a-b08c-4700-ae38-856383c188ee

	measure 'IN8 Nguồn' =
			VAR t = FILTER(ADDCOLUMNS(VALUES('dwh dim_nguon_gioi_thieu'[nhom_nguon]), "@dt", [DT Khám]), [@dt] > 0)
			VAR b = TOPN(1, t, [@dt], DESC)
			VAR mk = CALCULATE([DT Khám], KEEPFILTERS('dwh dim_nguon_gioi_thieu'[nhom_nguon] = "Marketing"))
			RETURN "Nguồn mang lại DT lớn nhất: " & MAXX(b, 'dwh dim_nguon_gioi_thieu'[nhom_nguon]) & " (" & FORMAT(DIVIDE(MAXX(b, [@dt]), [DT Khám]), "0%") & "). Marketing chỉ đóng góp " & FORMAT(DIVIDE(mk, [DT Khám]), "0%") & " — nên đánh giá lại hiệu quả kênh quảng cáo."
		displayFolder: 8. Insights
		lineageTag: ae7c993a-7c07-4240-bd1d-435774ed5aad

	measure 'IN9 Khuyến mãi' =
			VAR t = FILTER(ADDCOLUMNS(VALUES('dwh dim_dich_vu'[ten_dich_vu]), "@g", [Giảm giá khám]), [@g] > 0)
			VAR b = TOPN(1, t, [@g], DESC)
			RETURN "Tổng khuyến mãi " & FORMAT(([Tổng khuyến mãi]) / 1000000000, "#,0.00") & " tỷ" & "; giảm giá khám bằng " & FORMAT(DIVIDE([Giảm giá khám], [DT gốc khám]), "0%") & " DT gốc. Giảm nhiều nhất: " & MAXX(b, 'dwh dim_dich_vu'[ten_dich_vu]) & " (" & FORMAT((MAXX(b, [@g])) / 1000000000, "#,0.00") & " tỷ" & ")."
		displayFolder: 8. Insights
		lineageTag: e578b7cf-a182-460b-8690-74888850c791

	measure 'IN10 Quay lại' =
			VAR bn = VALUES('dwh fact_kham'[ma_bn])
			VAR ql = FILTER(bn, CALCULATE(MAX('dwh fact_kham'[lan_kham])) >= 2)
			VAR dql = CALCULATE([DT Khám], ql)
			RETURN FORMAT(DIVIDE(COUNTROWS(ql), COUNTROWS(bn)), "0%") & " bệnh nhân quay lại khám từ 2 lần trở lên, đóng góp " & FORMAT(DIVIDE(dql, [DT Khám]), "0%") & " DT khám. Chăm sóc sau khám (nhắc tái khám) sẽ giúp tăng tỷ lệ này."
		displayFolder: 8. Insights
		lineageTag: 858e7310-330b-43d5-ba96-6f3c77a1131b

	measure 'IN11 Kính' =
			VAR t = CALCULATETABLE(FILTER(ADDCOLUMNS(VALUES('dwh dim_san_pham'[nhom_hang]), "@dt", [DT Bán hàng]), [@dt] > 0), 'dwh dim_san_pham'[loai_quay] = "Kính")
			VAR b = TOPN(1, t, [@dt], DESC)
			VAR kl = DIVIDE(CALCULATE([DT Kính], KEEPFILTERS('dwh fact_ban_hang'[loai_khach] = "Khách lẻ")), [DT Kính])
			RETURN MAXX(b, 'dwh dim_san_pham'[nhom_hang]) & " dẫn đầu quầy kính (" & FORMAT(DIVIDE(MAXX(b, [@dt]), [DT Kính]), "0%") & "). " & FORMAT(kl, "0%") & " DT kính từ khách lẻ không khám — cơ hội chuyển đổi sang khám mắt."
		displayFolder: 8. Insights
		lineageTag: cc96d248-9926-4092-83ac-c3ce2289cc9d

	measure 'IN12 Thuốc' =
			VAR t = CALCULATETABLE(FILTER(ADDCOLUMNS(VALUES('dwh dim_san_pham'[nhom_hang]), "@dt", [DT Bán hàng]), [@dt] > 0), 'dwh dim_san_pham'[loai_quay] = "Thuốc")
			VAR b = TOPN(1, t, [@dt], DESC)
			VAR ml = DIVIDE(CALCULATE([DT Thuốc], KEEPFILTERS('dwh fact_ban_hang'[doi_tuong_kham] = "Không khám (mua lẻ)")), [DT Thuốc])
			VAR bh = DIVIDE(CALCULATE([DT Thuốc], KEEPFILTERS('dwh fact_ban_hang'[doi_tuong_kham] = "BHYT")), [DT Thuốc])
			RETURN MAXX(b, 'dwh dim_san_pham'[nhom_hang]) & " chiếm " & FORMAT(DIVIDE(MAXX(b, [@dt]), [DT Thuốc]), "0%") & " DT thuốc. Mua lẻ " & FORMAT(ml, "0%") & ", khách BHYT " & FORMAT(bh, "0%") & "."
		displayFolder: 8. Insights
		lineageTag: e3a57c48-73ce-4949-a1e0-a9541a4408bf

	column x
