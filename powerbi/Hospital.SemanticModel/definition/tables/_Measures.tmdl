/// Bảng chứa các measure của dashboard
table _Measures
	lineageTag: 3a9816c4-1663-4d10-a55f-9f30d05f761c

	measure 'DT Khám' = SUM('dwh fact_kham'[doanh_thu_thuan])
		displayFolder: 1. Doanh thu
		lineageTag: 39ae36ca-7cbc-4ffd-88d0-e23fd9de7207

		formatStringDefinition = IF(ABS(SELECTEDMEASURE()) >= 1000000000, """" & FORMAT(SELECTEDMEASURE() / 1000000000, "#,0.00") & " tỷ""", IF(ABS(SELECTEDMEASURE()) >= 1000000, """" & FORMAT(SELECTEDMEASURE() / 1000000, "#,0.##") & " tr""", "#,0"" ₫"""))

	measure 'DT Bán hàng' = CALCULATE(SUM('dwh fact_ban_hang'[tien_thu]), KEEPFILTERS('dwh dim_san_pham'[nhom_hang] <> "Tạm ứng"))
