	measure 'TB lượt khám/ngày' = DIVIDE([Số lượt khám], [Số ngày có khám])
		formatString: #,0.0
		displayFolder: 5. Trung bình
		lineageTag: 24db07e0-d810-408f-a0a8-1743cca7e2fb

