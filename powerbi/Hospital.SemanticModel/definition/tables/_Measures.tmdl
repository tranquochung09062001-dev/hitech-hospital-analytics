	measure 'DT tháng trước' = CALCULATE([Tổng DT], DATEADD('dwh dim_ngay'[ngay], -1, MONTH))
		displayFolder: 4. So sánh
		lineageTag: 8c515164-17cc-4de0-94ab-c8563551fcfa

		formatStringDefinition = IF(ABS(SELECTEDMEASURE()) >= 1000000000, """" & FORMAT(SELECTEDMEASURE() / 1000000000, "#,0.00") & " tỷ""", IF(ABS(SELECTEDMEASURE()) >= 1000000, """" & FORMAT(SELECTEDMEASURE() / 1000000, "#,0.##") & " tr""", "#,0"" ₫"""))

	measure '% Tăng trưởng tháng' =
			VAR lastData =
			    CALCULATE(MAX('dwh dim_ngay'[ngay]), FILTER(VALUES('dwh dim_ngay'[ngay]), NOT ISBLANK([Tổng DT])))
			VAR endMonth =
			    IF(
			        HASONEVALUE('dwh dim_ngay'[ky_sort]),
			        MAX('dwh dim_ngay'[ngay]),
			        IF(lastData = EOMONTH(lastData, 0), lastData, EOMONTH(lastData, -1))
			    )
			VAR cur  = CALCULATE([Tổng DT], DATESBETWEEN('dwh dim_ngay'[ngay], EOMONTH(endMonth, -1) + 1, EOMONTH(endMonth, 0)), REMOVEFILTERS('dwh dim_ngay'[ngay], 'dwh dim_ngay'[thang], 'dwh dim_ngay'[ten_thang], 'dwh dim_ngay'[thang_nam], 'dwh dim_ngay'[ky_sort], 'dwh dim_ngay'[quy], 'dwh dim_ngay'[ngay_trong_thang], 'dwh dim_ngay'[thu_trong_tuan], 'dwh dim_ngay'[ten_thu]))
			VAR prev = CALCULATE([Tổng DT], DATESBETWEEN('dwh dim_ngay'[ngay], EOMONTH(endMonth, -2) + 1, EOMONTH(endMonth, -1)), REMOVEFILTERS('dwh dim_ngay'[ngay], 'dwh dim_ngay'[thang], 'dwh dim_ngay'[ten_thang], 'dwh dim_ngay'[thang_nam], 'dwh dim_ngay'[ky_sort], 'dwh dim_ngay'[quy], 'dwh dim_ngay'[ngay_trong_thang], 'dwh dim_ngay'[thu_trong_tuan], 'dwh dim_ngay'[ten_thu]))
			RETURN IF(NOT ISBLANK(cur) && NOT ISBLANK(prev), DIVIDE(cur - prev, prev))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 4. So sánh
		lineageTag: 1592cd61-8ffd-448e-abeb-ca044e1e2b72

	measure 'DT lũy kế năm' = TOTALYTD([Tổng DT], 'dwh dim_ngay'[ngay])
		displayFolder: 4. So sánh
		lineageTag: 557c2d0d-a82a-4ca2-a229-78e4010b05ae

		formatStringDefinition = IF(ABS(SELECTEDMEASURE()) >= 1000000000, """" & FORMAT(SELECTEDMEASURE() / 1000000000, "#,0.00") & " tỷ""", IF(ABS(SELECTEDMEASURE()) >= 1000000, """" & FORMAT(SELECTEDMEASURE() / 1000000, "#,0.##") & " tr""", "#,0"" ₫"""))

	measure '% DT Khám' = DIVIDE([DT Khám], [Tổng DT])
