	measure 'Top 10 giảm giá (tr₫)' =
			VAR r = RANKX(ALLSELECTED('dwh dim_dich_vu'[ten_dich_vu]), [Giảm giá khám], , DESC, Dense)
			RETURN IF(r <= 10 && [Giảm giá khám] > 0, DIVIDE([Giảm giá khám], 1000000))
		displayFolder: 6. Biểu đồ (triệu ₫)
