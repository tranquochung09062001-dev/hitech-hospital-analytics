	/// Tỷ trọng doanh thu khám của dòng hiện tại so với tổng (dùng cho bảng/biểu đồ theo nhóm)
	measure '% trên tổng (khám)' = DIVIDE([DT Khám], CALCULATE([DT Khám], ALLSELECTED()))
		formatString: 0.0%
		displayFolder: 4. So sánh
		lineageTag: 09aa9c91-f729-4433-b0d0-9d555b169e6c

	measure 'Số ngày có khám' = COUNTROWS(FILTER(VALUES('dwh dim_ngay'[ngay]), CALCULATE(COUNTROWS('dwh fact_kham')) > 0))
		formatString: #,0
		isHidden
		displayFolder: 5. Trung bình
		lineageTag: e078da75-54ac-49cd-a4a4-b7f73e68c31b

	/// Tổng doanh thu chia số ngày có phát sinh (khám hoặc bán hàng)
	measure 'TB DT/ngày' = AVERAGEX(FILTER(VALUES('dwh dim_ngay'[ngay]), NOT ISBLANK([Tổng DT])), [Tổng DT])
		displayFolder: 5. Trung bình
		lineageTag: 4493a79b-5be4-42e9-b5d0-0950f6c7c419

		formatStringDefinition = IF(ABS(SELECTEDMEASURE()) >= 1000000000, """" & FORMAT(SELECTEDMEASURE() / 1000000000, "#,0.00") & " tỷ""", IF(ABS(SELECTEDMEASURE()) >= 1000000, """" & FORMAT(SELECTEDMEASURE() / 1000000, "#,0.##") & " tr""", "#,0"" ₫"""))

	measure 'TB DT khám/ngày' = DIVIDE([DT Khám], [Số ngày có khám])
