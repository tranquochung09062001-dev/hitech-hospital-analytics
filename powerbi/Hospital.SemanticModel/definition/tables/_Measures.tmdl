	measure 'Kỳ tăng trưởng' =
			VAR lastData =
			    CALCULATE(MAX('dwh dim_ngay'[ngay]), FILTER(VALUES('dwh dim_ngay'[ngay]), NOT ISBLANK([Tổng DT])))
			VAR endMonth =
			    IF(
			        HASONEVALUE('dwh dim_ngay'[ky_sort]),
			        MAX('dwh dim_ngay'[ngay]),
			        IF(lastData = EOMONTH(lastData, 0), lastData, EOMONTH(lastData, -1))
			    )
			RETURN "T" & FORMAT(endMonth, "MM/yyyy") & " so với T" & FORMAT(EOMONTH(endMonth, -1), "MM/yyyy")
		displayFolder: 4. So sánh
		lineageTag: 3ff0e2cd-c709-4429-8e1d-8ee28725eea3

