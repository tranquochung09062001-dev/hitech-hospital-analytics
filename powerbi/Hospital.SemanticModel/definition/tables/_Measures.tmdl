	measure 'TB lượt khám/tháng' = AVERAGEX(FILTER(SUMMARIZE('dwh dim_ngay', 'dwh dim_ngay'[nam], 'dwh dim_ngay'[thang]), NOT ISBLANK([Số lượt khám])), [Số lượt khám])
		formatString: #,0
		displayFolder: 5. Trung bình
		lineageTag: 49573dcd-e797-471a-bb1c-6407251628ef

