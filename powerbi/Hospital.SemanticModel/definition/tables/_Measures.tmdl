		lineageTag: 895f0410-621c-4832-a879-aa7fc78b1771

	measure 'TB đơn/ngày' = AVERAGEX(FILTER(VALUES('dwh dim_ngay'[ngay]), [Số đơn] > 0), [Số đơn])
		formatString: #,0.0
		displayFolder: 5. Trung bình
