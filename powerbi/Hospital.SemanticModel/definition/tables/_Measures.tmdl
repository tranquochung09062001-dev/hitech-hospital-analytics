	measure 'Top 1 DV lượt tháng' =
			VAR khamCoBan = MAXX(TOPN(1, ALL('dwh dim_dich_vu'[ten_dich_vu]), CALCULATE([Số lượt khám], REMOVEFILTERS('dwh dim_ngay')), DESC), 'dwh dim_dich_vu'[ten_dich_vu])
			VAR ten = SELECTEDVALUE('dwh dim_dich_vu'[ten_dich_vu])
			VAR r = RANKX(FILTER(ALLSELECTED('dwh dim_dich_vu'[ten_dich_vu]), 'dwh dim_dich_vu'[ten_dich_vu] <> khamCoBan), [Số lượt khám], , DESC, Dense)
			RETURN IF(ten <> khamCoBan && r = 1 && NOT ISBLANK([Số lượt khám]), [Số lượt khám])
