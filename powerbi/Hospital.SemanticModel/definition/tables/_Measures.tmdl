	/// Số dịch vụ trung bình trong 1 lượt khám
	measure 'TB dịch vụ/lượt' = DIVIDE(COUNTROWS('dwh fact_kham'), [Số lượt khám])
		formatString: #,0.00
		displayFolder: 5. Trung bình
		lineageTag: 7c52137e-ee12-4640-84c4-8506434992ec

	/// Tuổi trung bình tính theo lượt khám
	measure 'TB tuổi' = AVERAGEX(SUMMARIZE('dwh fact_kham', 'dwh fact_kham'[ma_kcb], "t", MAX('dwh fact_kham'[tuoi])), [t])
		formatString: #,0.0
		displayFolder: 5. Trung bình
		lineageTag: 1b5498f9-0b52-43e3-bb5a-76a410a7ec5b

	measure 'TB mặt hàng/đơn' = DIVIDE(CALCULATE(COUNTROWS('dwh fact_ban_hang'), KEEPFILTERS('dwh dim_san_pham'[nhom_hang] <> "Tạm ứng")), [Số đơn])
		formatString: #,0.00
