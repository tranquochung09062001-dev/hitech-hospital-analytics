	measure 'Lọc top DV' =
			VAR mode = SELECTEDVALUE('Chế độ top'[Chế độ], "Top 10 cao nhất")
			VAR dt = [DT Khám]
			VAR nhom = CALCULATE(MAX('dwh dim_dich_vu'[nhom_dich_vu]))
			VAR hiSet = FILTER(ALLSELECTED('dwh dim_dich_vu'[ten_dich_vu]), CALCULATE(MAX('dwh dim_dich_vu'[nhom_dich_vu])) <> "Xét nghiệm")
			VAR loSet = FILTER(ALLSELECTED('dwh dim_dich_vu'[ten_dich_vu]), CALCULATE(MAX('dwh dim_dich_vu'[nhom_dich_vu])) = "Phẫu thuật" && [DT Khám] > 0)
			VAR rHi = RANKX(hiSet, [DT Khám], , DESC, Dense)
			VAR rLo = RANKX(loSet, [DT Khám], , ASC, Dense)
			RETURN IF(ISBLANK(dt) || dt <= 0 || nhom = "Xét nghiệm", 0, IF(LEFT(mode, 10) = "Top 10 cá", IF(rHi <= 10, 1, 0), IF(nhom = "Phẫu thuật" && rLo <= 10, 1, 0)))
		formatString: 0
		isHidden
		displayFolder: 9. Lọc
		lineageTag: 933ec4b6-f8ba-4d98-b4aa-640e45aa6dec

