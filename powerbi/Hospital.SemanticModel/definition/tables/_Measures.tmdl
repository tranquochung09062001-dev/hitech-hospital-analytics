	measure 'TB DT/tháng' = AVERAGEX(FILTER(SUMMARIZE('dwh dim_ngay', 'dwh dim_ngay'[nam], 'dwh dim_ngay'[thang]), NOT ISBLANK([Tổng DT])), [Tổng DT])
		displayFolder: 5. Trung bình
