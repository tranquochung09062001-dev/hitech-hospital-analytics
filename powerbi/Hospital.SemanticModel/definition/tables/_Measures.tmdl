	measure 'TB tiền BHYT/lượt BHYT' = DIVIDE([Tiền BHYT], [Số lượt BHYT])
		displayFolder: 5. Trung bình
		lineageTag: fcf5e673-3ff0-4080-bb70-a29d4c1ba89e

		formatStringDefinition = IF(ABS(SELECTEDMEASURE()) >= 1000000000, """" & FORMAT(SELECTEDMEASURE() / 1000000000, "#,0.00") & " tỷ""", IF(ABS(SELECTEDMEASURE()) >= 1000000, """" & FORMAT(SELECTEDMEASURE() / 1000000, "#,0.##") & " tr""", "#,0"" ₫"""))

	measure 'TB giảm giá/lượt' = DIVIDE([Giảm giá khám], [Số lượt khám])
		displayFolder: 5. Trung bình
		lineageTag: 556ae718-4c57-497d-86e2-0dcfb1d52c15

		formatStringDefinition = IF(ABS(SELECTEDMEASURE()) >= 1000000000, """" & FORMAT(SELECTEDMEASURE() / 1000000000, "#,0.00") & " tỷ""", IF(ABS(SELECTEDMEASURE()) >= 1000000, """" & FORMAT(SELECTEDMEASURE() / 1000000, "#,0.##") & " tr""", "#,0"" ₫"""))

	measure 'TB số lượt/bệnh nhân' = DIVIDE([Số lượt khám], [Số bệnh nhân])
		formatString: #,0.00
		displayFolder: 5. Trung bình
