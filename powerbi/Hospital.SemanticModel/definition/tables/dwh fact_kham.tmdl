	column nhom_tuoi_sort
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: f9ab08a5-09da-42ad-8c4c-fd6f025c4cd1
		summarizeBy: none
		sourceColumn: nhom_tuoi_sort

	/// Nội trú = lượt khám (mã KCB) có dịch vụ nhóm Phẫu thuật
	column loai_dieu_tri =
			VAR pt = CALCULATETABLE(VALUES('dwh dim_dich_vu'[dich_vu_key]), ALL('dwh dim_dich_vu'), 'dwh dim_dich_vu'[nhom_dich_vu] = "Phẫu thuật")
			RETURN IF(CALCULATE(COUNTROWS('dwh fact_kham'), ALLEXCEPT('dwh fact_kham', 'dwh fact_kham'[ma_kcb]), 'dwh fact_kham'[dich_vu_key] IN pt) > 0, "Nội trú", "Ngoại trú")
		dataType: string
		lineageTag: c84ff279-7370-4dc4-9c45-bb1fe16ddf5a
		summarizeBy: none

	column lan_kham =
			VAR dk = 'dwh fact_kham'[date_key]
			RETURN CALCULATE(DISTINCTCOUNT('dwh fact_kham'[date_key]), ALLEXCEPT('dwh fact_kham', 'dwh fact_kham'[ma_bn]), 'dwh fact_kham'[date_key] <= dk)
		dataType: int64
		formatString: 0
		lineageTag: 7f8e115d-891e-49ab-9aa2-72f5b2561e90
		summarizeBy: none

	column la_ten_gioi_thieu =
			VAR s = TRIM('dwh fact_kham'[nguoi_gioi_thieu])
			VAR p = SUBSTITUTE(SUBSTITUTE(s, "|", ""), " ", "|")
			VAR n = PATHLENGTH(p)
			VAR lowerWords = COUNTROWS(FILTER(GENERATESERIES(1, n), VAR w = PATHITEM(p, [Value]) VAR c = LEFT(w, 1) RETURN EXACT(c, LOWER(c)) && NOT EXACT(c, UPPER(c))))
			VAR hasDigit = SUMX(GENERATESERIES(0, 9), IF(CONTAINSSTRING(s, FORMAT([Value], "0")), 1)) > 0
			VAR isCTV = SEARCH("CTV", s, 1, 0) > 0
			RETURN IF(LEN(s) > 0 && (isCTV || (n >= 2 && n <= 6 && lowerWords = 0 && NOT EXACT(s, UPPER(s)) && NOT hasDigit)), "Có", "Không")
		dataType: string
		isHidden
		lineageTag: a679c06e-ee2d-4767-a2bc-1b4b2ff05efa
		summarizeBy: none

	column ma_kcb_txt = FORMAT('dwh fact_kham'[ma_kcb], "0")
		dataType: string
		lineageTag: 6f15ca75-69f5-47ea-b05b-cec450db8b85
		summarizeBy: none

	column ngay_kham = DATE(YEAR('dwh fact_kham'[ngay_dang_ky]), MONTH('dwh fact_kham'[ngay_dang_ky]), DAY('dwh fact_kham'[ngay_dang_ky]))
		dataType: dateTime
		formatString: dd/MM/yyyy
		lineageTag: 1cfda65e-fcdd-4ea5-be65-2faac835b777
		summarizeBy: none

	column ten_bn = RELATED('dwh dim_benh_nhan'[ho_ten])
		dataType: string
		lineageTag: 2b6a3ac4-6d28-4cb2-a9de-41e12ee08bc8
		summarizeBy: none

	partition 'dwh fact_kham' = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database("localhost", "Hitech Hospital"),
				    dwh_fact_kham = Source{[Schema="dwh",Item="fact_kham"]}[Data],
				    ThemSort = Table.AddColumn(dwh_fact_kham, "nhom_tuoi_sort", each
				        let g = [nhom_tuoi] in
				        if g = "0-5" then 1 else if g = "6-15" then 2 else if g = "16-25" then 3
				        else if g = "26-40" then 4 else if g = "41-60" then 5 else if g = "60+" then 6 else 7, Int64.Type)
				in
				    ThemSort

	annotation PBI_ResultType = Table

